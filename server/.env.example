# Bu dosyayi ".env" olarak kopyalayip degerleri doldurun:
#   cp .env.example .env
# .env dosyasi git'e GONDERILMEZ (.gitignore'da).

# --- Veritabani ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bsmt
DB_POOL=10

# --- Oturum ---
# Rastgele uzun bir deger uretin:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=8h

# --- Ilk yonetici hesabi (npm run seed bunu olusturur) ---
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_NAME=BSMT Yonetim

# --- Sunucu ---
PORT=3000
